menu "Matter SCD40 OLED Configuration"

    config I2C_MASTER_SDA_PIN
        int "I2C Master SDA GPIO"
        default 22
        help
            GPIO pin for I2C SDA line. Default is GPIO22 for XIAO ESP32-C6.

    config I2C_MASTER_SCL_PIN
        int "I2C Master SCL GPIO"
        default 23
        help
            GPIO pin for I2C SCL line. Default is GPIO23 for XIAO ESP32-C6.

    config I2C_MASTER_FREQ_HZ
        int "I2C Master Frequency (Hz)"
        default 100000
        help
            I2C bus frequency in Hz. SCD40 supports up to 100kHz standard mode.

    config SCD40_I2C_ADDRESS
        hex "SCD40 I2C Address"
        default 0x62
        help
            I2C address of the SCD40 CO2 sensor. Default is 0x62.

    config OLED_I2C_ADDRESS
        hex "OLED Display I2C Address"
        default 0x3C
        help
            I2C address of the SSD1306 OLED display. Default is 0x3C.

    config SENSOR_READ_INTERVAL_MS
        int "Sensor Read Interval (ms)"
        default 5000
        help
            Interval between SCD40 sensor readings in milliseconds.
            SCD40 has a measurement interval of approximately 5 seconds.

    config DISPLAY_UPDATE_INTERVAL_MS
        int "Display Update Interval (ms)"
        default 1000
        help
            Interval between OLED display updates in milliseconds.

    config RESET_BUTTON_GPIO
        int "Factory Reset Button GPIO"
        default 9
        help
            GPIO pin for the factory reset button. Default is GPIO9 (BOOT button on XIAO).

    config THREAD_STATUS_LED_GPIO
        int "Thread Status LED GPIO"
        default 15
        help
            GPIO pin for Thread connection status LED. Default is GPIO15 (built-in LED on XIAO).

endmenu
